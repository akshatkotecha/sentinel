SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard > Project Settings > API Keys > secret key. Server-side only.
SUPABASE_SECRET_KEY=sb_secret_...

# Free at console.groq.com. Scoring falls back to a neutral LLM score without it.
GROQ_API_KEY=gsk_...
# Optional: override the default Groq model.
# GROQ_MODEL=openai/gpt-oss-20b

# Must match the secret set on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=change-me
# Optional: needed only to score commits from private repos.
# GITHUB_TOKEN=github_pat_...
